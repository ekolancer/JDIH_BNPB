#--------------------------------------------------------------------------
# Konfigurasi Aplikasi
#--------------------------------------------------------------------------
# APP_NAME       : Nama aplikasi, tampil di title browser & email
# APP_ENV        : Environment (local, staging, production)
# APP_KEY        : Encryption key, generate via: php artisan key:generate
# APP_DEBUG      : true = tampilkan error detail (JANGAN true di production!)
# APP_TIMEZONE   : Timezone server, Indonesia = Asia/Jakarta
# APP_URL        : URL utama aplikasi (tanpa trailing slash)

APP_NAME=JDIH_BNPB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

#--------------------------------------------------------------------------
# Lokalisasi
#--------------------------------------------------------------------------
# APP_LOCALE          : Bahasa default aplikasi
# APP_FALLBACK_LOCALE : Bahasa fallback jika terjemahan tidak ditemukan
# APP_FAKER_LOCALE    : Locale untuk data dummy (seeder/factory)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

#--------------------------------------------------------------------------
# Maintenance Mode
#--------------------------------------------------------------------------
# APP_MAINTENANCE_DRIVER : Driver untuk mode maintenance (file / database)
# Jika pakai 'file', cukup jalankan: php artisan down

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

#--------------------------------------------------------------------------
# PHP CLI
#--------------------------------------------------------------------------
# PHP_CLI_SERVER_WORKERS : Jumlah worker saat pakai php artisan serve
#                          Lebih banyak = bisa handle lebih banyak request paralel

PHP_CLI_SERVER_WORKERS=4

#--------------------------------------------------------------------------
# Security
#--------------------------------------------------------------------------
# BCRYPT_ROUNDS : Jumlah round hashing password (semakin tinggi = semakin aman tapi lambat)
#                 Default 12 sudah cukup untuk production

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
# LOG_CHANNEL             : Channel log utama (stack, single, daily, slack, dll)
# LOG_STACK               : Channel yang dipakai jika LOG_CHANNEL=stack
# LOG_DEPRECATIONS_CHANNEL: Channel khusus untuk deprecation warning
# LOG_LEVEL               : Level minimum yang dicatat (debug, info, warning, error, critical)

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Database
#--------------------------------------------------------------------------
# DB_CONNECTION : Driver database (mysql, pgsql, sqlite, sqlsrv)
# DB_HOST       : Hostname/IP database server
# DB_PORT       : Port database (MySQL=3306, PostgreSQL=5432)
# DB_DATABASE   : Nama database
# DB_USERNAME   : Username database
# DB_PASSWORD   : Password database

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jdih_bnpb
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# Session
#--------------------------------------------------------------------------
# SESSION_DRIVER   : Tempat penyimpanan session (database, file, redis, cookie)
# SESSION_LIFETIME : Durasi session aktif dalam menit (60 = 1 jam)
# SESSION_ENCRYPT  : Enkripsi data session (true/false)
# SESSION_PATH     : Path cookie session
# SESSION_DOMAIN   : Domain cookie session (null = auto detect)

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#--------------------------------------------------------------------------
# Broadcasting, Filesystem, Queue, Cache
#--------------------------------------------------------------------------
# BROADCAST_CONNECTION : Driver broadcast (log, pusher, redis)
# FILESYSTEM_DISK      : Disk default untuk file upload (local, public, s3)
# QUEUE_CONNECTION     : Driver queue/antrian job (database, redis, sync)
# CACHE_STORE          : Driver cache (database, file, redis, memcached)
# CACHE_PREFIX         : Prefix key cache (berguna jika share Redis dengan app lain)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

#--------------------------------------------------------------------------
# Memcached (opsional, hanya jika CACHE_STORE=memcached)
#--------------------------------------------------------------------------

MEMCACHED_HOST=127.0.0.1

#--------------------------------------------------------------------------
# Redis (opsional, hanya jika pakai Redis untuk cache/queue/session)
#--------------------------------------------------------------------------
# REDIS_CLIENT   : PHP Redis client (phpredis atau predis)
# REDIS_HOST     : Hostname Redis server
# REDIS_PASSWORD : Password Redis (null jika tanpa auth)
# REDIS_PORT     : Port Redis (default 6379)

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------------
# MAIL_MAILER       : Driver email (smtp, mailgun, ses, log)
#                     'log' = email hanya ditulis ke log (untuk development)
# MAIL_HOST         : SMTP server hostname
# MAIL_PORT         : SMTP port (587=TLS, 465=SSL, 2525=dev)
# MAIL_USERNAME     : Username SMTP
# MAIL_PASSWORD     : Password SMTP
# MAIL_ENCRYPTION   : Enkripsi (tls, ssl, null)
# MAIL_FROM_ADDRESS : Alamat pengirim default
# MAIL_FROM_NAME    : Nama pengirim default

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# AWS (opsional, hanya jika pakai S3/SES)
#--------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# Vite (Frontend Build Tool)
#--------------------------------------------------------------------------
# VITE_APP_NAME : Nama app yang bisa diakses di frontend via import.meta.env

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Google Analytics
#--------------------------------------------------------------------------
# GOOGLE_ANALYTICS_ID              : Measurement ID dari GA4 (format: G-XXXXXXXXXX)
#                                    Ditemukan di: GA4 > Admin > Data Streams > Measurement ID
#                                    Digunakan untuk inject tracking script di halaman admin
#
# GOOGLE_ANALYTICS_PROPERTY_ID     : Property ID (angka saja, contoh: 495444302)
#                                    Ditemukan di: GA4 > Admin > Property Settings > Property ID
#                                    Digunakan untuk fetch data via GA4 Data API
#
# GOOGLE_ANALYTICS_CREDENTIALS_PATH: Path absolut ke file Service Account JSON
#                                    Default: storage/app/private/google-analytics-credentials.json
#                                    Kosongkan jika file diletakkan di lokasi default
#
# SETUP:
# 1. Buka Google Cloud Console > APIs & Services > Credentials
# 2. Buat Service Account > Download JSON key
# 3. Di GA4 > Admin > Property Access Management > tambahkan email service account
#    dengan role "Viewer"
# 4. Letakkan file JSON di storage/app/private/google-analytics-credentials.json
# 5. Isi GOOGLE_ANALYTICS_PROPERTY_ID dengan Property ID dari GA4

GOOGLE_ANALYTICS_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS_PATH=

# Database Dump Binary Path (untuk spatie/laravel-backup)
# Windows (Laragon): C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin
# Linux: /usr/bin
DB_DUMP_BINARY_PATH=
